SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never expose it to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
FRONTEND_URL=https://www.petite-dreams.com
SCRAPINGBEE_API_KEY=
PORT=3001
# Payments: "demo" approves every charge until a real gateway is connected.
PAYMENT_PROVIDER=demo
# Transactional email (vouchers, order confirmations, weekly link report) via Resend.
RESEND_API_KEY=
EMAIL_FROM=Petite Dreams <hello@petite-dreams.com>
EMAIL_REPLY_TO=
# Comma-separated recipients of the weekly broken-link report.
ADMIN_EMAIL=
# Vercel Cron authorization for /api/cron/link-check.
CRON_SECRET=
# Google Gemini key for the AI room visualization on the package page (billing must be enabled).
GEMINI_API_KEY=
# Optional: image model and per-user daily cap for room visualizations.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
VISUALIZE_DAILY_LIMIT=30
