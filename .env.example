SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FRONTEND_URL=https://www.petite-dreams.com
SCRAPINGBEE_API_KEY=
PORT=3001
# Server-only key for orders, coupons, vouchers and admin data. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Payments: "demo" approves every charge until a real gateway is connected.
PAYMENT_PROVIDER=demo
# Transactional email (vouchers, order confirmations, weekly link report) via Resend.
RESEND_API_KEY=
EMAIL_FROM=Petite Dreams <hello@petite-dreams.com>
EMAIL_REPLY_TO=
# Comma-separated recipients of the weekly broken-link report.
ADMIN_EMAIL=
# Vercel Cron authorization for /api/cron/link-check.
CRON_SECRET=
